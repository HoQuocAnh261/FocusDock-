{
  "id": "com.focusdock.desktop",
  "name": "FocusDock — Pomodoro Timer",
  "short_name": "FocusDock",
  "description": "Minimalist Windows 11 Pomodoro timer and offline ambient sound mixer for deep work, study, and flow state.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#080b11",
  "theme_color": "#3b82f6",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "productivity",
    "utilities",
    "health"
  ],
  "icons": [
